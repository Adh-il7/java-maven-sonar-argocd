pipeline {
    agent {
        docker {
            image 'jibin321/maven-docker-agent:v2'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                sh '''
                    echo "Workspace:"
                    pwd

                    echo "Files:"
                    ls -la

                    echo "Git directory:"
                    ls -la .git || true
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    cd spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        cd spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                            -Dsonar.projectKey=my-ec2-project \
                            -Dsonar.sources=src
                    '''
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "adhil7/springbootapp:${BUILD_NUMBER}"
            }

            steps {
                script {
                    sh '''
                        cd spring-boot-app

                        docker build -t ${DOCKER_IMAGE} .
                    '''

                    def dockerImage = docker.image("${DOCKER_IMAGE}")

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }

        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "java-maven-sonar-argocd"
                GIT_USER_NAME = "Adh-il7"
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GITHUB_USERNAME',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "Checking workspace..."

                        pwd
                        ls -la

                        echo "Checking Git..."
                        git status

                        git config user.email "adhilstar303@gmail.com"
                        git config user.name "${GIT_USER_NAME}"

                        echo "Updating deployment image..."

                        sed -i "s|image: .*|image: adhil7/springbootapp:${BUILD_NUMBER}|g" \
                            spring-boot-app-manifests/deployment.yml

                        echo "Deployment file after update:"
                        cat spring-boot-app-manifests/deployment.yml

                        git add spring-boot-app-manifests/deployment.yml

                        git commit \
                            -m "Update image tag to ${BUILD_NUMBER} [skip ci]" \
                            || echo "No changes to commit"

                        git push \
                            https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                            HEAD:main
                    '''
                }
            }
        }
    }
}
